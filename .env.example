# Salin menjadi .env di root proyek dan ganti kedua placeholder password.
NODE_ENV=development
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ith_library
DB_USER=ith_app
DB_PASSWORD=replace-with-strong-local-password
MYSQL_ROOT_PASSWORD=replace-with-different-strong-local-password
DB_POOL_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000
DB_READY_TIMEOUT_MS=3000
BODY_LIMIT_BYTES=65536
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
ENABLE_SWAGGER=true
ADMIN_ORIGIN=http://127.0.0.1:3002
