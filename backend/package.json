{
  "name": "@ith/library-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint src test drizzle.config.ts",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test dist-test/test/env.spec.js dist-test/test/health.spec.js dist-test/test/http.spec.js dist-test/test/auth.spec.js dist-test/test/permissions.spec.js dist-test/test/cms.spec.js",
    "test:db": "npm run build:test && node --test dist-test/test/database.integration.spec.js dist-test/test/auth.integration.spec.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/assert-supported-roles.mjs && drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "admin:bootstrap": "node scripts/bootstrap-admins.mjs",
    "cms:seed-navigation": "node scripts/seed-navigation.mjs",
    "requests:seed-programs": "node scripts/seed-study-programs.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.5",
    "@types/node": "22.19.3",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
